{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["react", "node"],
    "noEmit": true
  },
  "include": [
    "index.client.tsx",
    "index.server.ts",
    "client/**/*.ts",
    "client/**/*.tsx",
    "server/**/*.ts",
    "shared/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
